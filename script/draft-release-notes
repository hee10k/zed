#!/usr/bin/env node --redirect-warnings=/dev/null

const { execFileSync } = require("child_process");

const SECTION_VERBS = {
  New: "Added",
  Improvements: "Improved",
  Fixes: "Fixed",
};

function parseReleaseNotes(body) {
  const match = String(body || "").match(/(?:^|\n)Release Notes:\s*\n([\s\S]*)/i);
  if (!match) {
    return { kind: "missing", text: "" };
  }

  const lines = match[1].split(/\r?\n\r?\n/, 1)[0].split(/\r?\n/);
  const firstBulletIndex = lines.findIndex((line) => /^\s*-\s+\S/.test(line));
  if (firstBulletIndex === -1) {
    return { kind: "missing", text: "" };
  }

  const bulletLines = [lines[firstBulletIndex].replace(/^\s*-\s+/, "").trim()];
  for (const line of lines.slice(firstBulletIndex + 1)) {
    if (line.trim() === "" || /^\s*-\s+\S/.test(line)) break;
    bulletLines.push(line.trim());
  }

  const text = bulletLines.join(" ").trim();
  if (/^N\/A\b/i.test(text)) {
    return { kind: "skip", text: "" };
  }
  return { kind: "explicit", text };
}

function classifyReleaseEntry(text) {
  if (/^Added\b/i.test(text)) return "New";
  if (/^Improved\b/i.test(text)) return "Improvements";
  if (/^Fixed\b/i.test(text)) return "Fixes";
  return null;
}

function lowercaseFirstCharacter(text) {
  return text.length === 0 ? text : text[0].toLowerCase() + text.slice(1);
}

function fallbackReleaseEntry(subject) {
  const match = String(subject || "").match(
    /^(feat|fix|perf)(?:\([^)]*\))?!?:\s*(.+)$/i,
  );
  if (!match) return null;

  const section = { feat: "New", fix: "Fixes", perf: "Improvements" }[
    match[1].toLowerCase()
  ];
  const verb = SECTION_VERBS[section];
  const leadingVerbPattern = {
    New: /^(?:add|adds|added)\b[\s:,-]*/i,
    Fixes: /^(?:fix|fixes|fixed)\b[\s:,-]*/i,
    Improvements: /^(?:improve|improves|improved|reduce|reduces|reduced)\b[\s:,-]*/i,
  }[section];
  const description = match[2]
    .replace(leadingVerbPattern, "")
    .replace(/\s+\(#\d+\)\s*$/, "")
    .trim();
  return {
    section,
    text: `${verb} ${lowercaseFirstCharacter(description)}`,
  };
}

function normalizeExplicitEntry(text) {
  const section = classifyReleaseEntry(text);
  if (!section) return null;
  const description = text.replace(/^(Added|Improved|Fixed)\b/i, "").trim();
  if (!description) return null;
  return {
    section,
    text: `${SECTION_VERBS[section]} ${description}`,
  };
}

function attachLink(text, commit) {
  if (/https:\/\/github\.com\/zed-industries\/zed\/(?:pull|issues|commit)\//i.test(text)) {
    return text;
  }
  if (commit.pr) {
    return `${text} ([#${commit.pr}](https://github.com/zed-industries/zed/pull/${commit.pr}))`;
  }
  return `${text} ([commit](https://github.com/zed-industries/zed/commit/${commit.hash}))`;
}

function formatCommitEntry(commit) {
  const parsed = parseReleaseNotes(commit.body);
  if (parsed.kind === "skip") return null;

  const entry =
    parsed.kind === "explicit"
      ? normalizeExplicitEntry(parsed.text)
      : fallbackReleaseEntry(commit.firstLine);
  if (!entry) return null;

  const text = attachLink(entry.text, commit);
  return {
    section: entry.section,
    text,
    key: `${entry.section}\n${text}`,
  };
}

function renderReleaseNotes(entries, compareUrl) {
  const seen = new Set();
  const grouped = new Map([
    ["New", []],
    ["Improvements", []],
    ["Fixes", []],
  ]);

  for (const entry of entries) {
    if (!entry || seen.has(entry.key)) continue;
    seen.add(entry.key);
    grouped.get(entry.section)?.push(entry.text);
  }

  const sections = [];
  for (const section of ["New", "Improvements", "Fixes"]) {
    const entriesForSection = grouped.get(section);
    if (!entriesForSection || entriesForSection.length === 0) continue;
    sections.push(`## ${section}\n\n${entriesForSection.map((entry) => `- ${entry}`).join("\n")}`);
  }

  if (sections.length === 0) {
    return `No public-facing changes in this release. [View the commits](${compareUrl}).\n`;
  }
  return `${sections.join("\n\n")}\n`;
}

function getCommits(oldTag, newTag) {
  const log = execFileSync(
    "git",
    [
      "-C",
      "target/shallow_clone",
      "log",
      `${oldTag}..${newTag}`,
      "--format=DIVIDER%n%H|||%s%n%b",
    ],
    { encoding: "utf8" },
  )
    .replace(/\r\n/g, "\n")
    .split("DIVIDER\n")
    .filter((commit) => commit.length > 0)
    .map((commit) => {
      const [header, ...bodyLines] = commit.split("\n");
      const [hash, ...subjectParts] = header.split("|||");
      const firstLine = subjectParts.join("|||").trim();
      const cherryPick = firstLine.match(/\(cherry-pick #([0-9]+)\)/)?.[1] || "";
      const pr = firstLine.match(/\(#(\d+)\)$/)?.[1] || "";
      return {
        hash,
        cherryPick,
        pr,
        firstLine,
        body: bodyLines.join("\n"),
      };
    });

  return log;
}

function main() {
  const version = process.argv[2];
  const channel = process.argv[3];
  const parts = String(version || "").split(".");

  if (
    process.argv.length !== 4 ||
    parts.length !== 3 ||
    parts.some((part) => !/^\d+$/.test(part)) ||
    (channel !== "stable" && channel !== "preview")
  ) {
    console.log("Usage: draft-release-notes <version> {stable|preview}");
    process.exit(1);
  }

  // We currently draft notes only for patch releases.
  if (parts[2] === "0") process.exit(0);

  const priorVersion = [parts[0], parts[1], Number(parts[2]) - 1].join(".");
  const suffix = channel === "preview" ? "-pre" : "";
  const [tag, priorTag] = [`v${version}${suffix}`, `v${priorVersion}${suffix}`];

  try {
    execFileSync("rm", ["-rf", "target/shallow_clone"]);
    execFileSync("git", [
      "clone",
      "https://github.com/zed-industries/zed",
      "target/shallow_clone",
      "--filter=tree:0",
      "--no-checkout",
      "--branch",
      tag,
      "--depth",
      100,
    ]);
    execFileSync("git", ["-C", "target/shallow_clone", "rev-parse", "--verify", tag]);
    try {
      execFileSync("git", ["-C", "target/shallow_clone", "rev-parse", "--verify", priorTag]);
    } catch {
      console.error(`Prior tag ${priorTag} not found`);
      process.exit(0);
    }
  } catch (error) {
    console.error(error.stderr?.toString() || error.toString());
    process.exit(1);
  }

  const compareUrl = `https://github.com/zed-industries/zed/compare/${priorTag}...${tag}#commits_bucket`;
  const entries = getCommits(priorTag, tag)
    .map(formatCommitEntry)
    .filter((entry) => entry !== null);
  console.log(renderReleaseNotes(entries, compareUrl));
}

if (require.main === module) {
  main();
}

module.exports = {
  classifyReleaseEntry,
  fallbackReleaseEntry,
  formatCommitEntry,
  parseReleaseNotes,
  renderReleaseNotes,
};
