#!/usr/bin/env node --redirect-warnings=/dev/null

const { execFileSync } = require("child_process");
const { parseArgs } = require("util");
const { releaseNotesSection, releaseNotesEntries } = require("./lib/release-notes");

const GPUI_PREFIX_PATTERN = /^- \[GPUI\]\s*/i;

const USAGE = [
  "Usage: draft-release-notes <version> {stable|preview} [--gpui]",
  "",
  "By default, release notes entries prefixed with `- [GPUI]` are excluded.",
  "With --gpui, only those entries are included, with the prefix removed.",
].join("\n");

const SECTION_VERBS = {
  New: "Added",
  Improvements: "Improved",
  Fixes: "Fixed",
};

function parseArguments() {
  let values, positionals;
  try {
    ({ values, positionals } = parseArgs({
      allowPositionals: true,
      options: { gpui: { type: "boolean", default: false } },
    }));
  } catch (e) {
    return { error: e.message };
  }

  let [version, channel, ...rest] = positionals;
  if (version == null || channel == null || rest.length > 0) {
    return { error: "Expected exactly two positional arguments: <version> {stable|preview}" };
  }

  const versionParts = version.split(".");
  if (versionParts.length !== 3 || versionParts.some((part) => !/^\d+$/.test(part))) {
    return { error: `Invalid version "${version}", expected <major>.<minor>.<patch>` };
  }
  const parts = versionParts.map((part) => Number(part));

  if (channel !== "stable" && channel !== "preview") {
    return { error: `Invalid channel "${channel}", expected "stable" or "preview"` };
  }

  return { version, channel, parts, gpui: values.gpui };
}

function filterReleaseNotes(releaseNotes, gpui) {
  return releaseNotes
    .split("\n")
    .filter((line) => line !== "" && GPUI_PREFIX_PATTERN.test(line) === gpui)
    .map((line) => (gpui ? line.replace(GPUI_PREFIX_PATTERN, "- ") : line))
    .join("\n");
}

function releaseNoteEntries(body, gpui) {
  const section = releaseNotesSection(String(body || ""));
  const entries = releaseNotesEntries(section).join("\n");
  const filtered = filterReleaseNotes(entries, gpui);
  return filtered === ""
    ? []
    : filtered.split("\n").map((entry) => entry.replace(/\s+/g, " ").trim());
}

function parseReleaseNotes(body, gpui = false) {
  const section = releaseNotesSection(String(body || ""));
  const allEntries = releaseNotesEntries(section);
  if (allEntries.length === 0) {
    return { kind: "missing", text: "" };
  }

  const entries = releaseNoteEntries(body, gpui);
  if (entries.length === 0) {
    return { kind: "skip", text: "" };
  }

  const text = entries[0].replace(/^\s*-\s+/, "").trim();
  if (/^N\/A\b/i.test(text) || text.includes("<public_issue_number_if_exists>")) {
    return { kind: "skip", text: "" };
  }
  return { kind: "explicit", text };
}

function classifyReleaseEntry(text) {
  if (/^Added\b/i.test(text)) return "New";
  if (/^Improved\b/i.test(text)) return "Improvements";
  if (/^Fixed\b/i.test(text)) return "Fixes";
  return null;
}

function lowercaseFirstCharacter(text) {
  return text.length === 0 ? text : text[0].toLowerCase() + text.slice(1);
}

function fallbackReleaseEntry(subject) {
  const match = String(subject || "").match(
    /^(feat|fix|perf)(?:\([^)]*\))?!?:\s*(.+)$/i,
  );
  if (!match) return null;

  const section = { feat: "New", fix: "Fixes", perf: "Improvements" }[
    match[1].toLowerCase()
  ];
  const verb = SECTION_VERBS[section];
  const leadingVerbPattern = {
    New: /^(?:add|adds|added)\b[\s:,-]*/i,
    Fixes: /^(?:fix|fixes|fixed)\b[\s:,-]*/i,
    Improvements: /^(?:improve|improves|improved|reduce|reduces|reduced)\b[\s:,-]*/i,
  }[section];
  const description = match[2]
    .replace(leadingVerbPattern, "")
    .replace(/\s+\(#\d+\)\s*$/, "")
    .trim();
  return {
    section,
    text: `${verb} ${lowercaseFirstCharacter(description)}`,
  };
}

function normalizeExplicitEntry(text) {
  const section = classifyReleaseEntry(text);
  if (!section) return null;
  const description = text.replace(/^(Added|Improved|Fixed)\b/i, "").trim();
  if (!description) return null;
  return {
    section,
    text: `${SECTION_VERBS[section]} ${description}`,
  };
}

function attachLink(text, commit) {
  if (/https:\/\/github\.com\/zed-industries\/zed\/(?:pull|issues|commit)\//i.test(text)) {
    return text;
  }
  if (commit.pr) {
    return `${text} ([#${commit.pr}](https://github.com/zed-industries/zed/pull/${commit.pr}))`;
  }
  return `${text} ([commit](https://github.com/zed-industries/zed/commit/${commit.hash}))`;
}

function formatCommitEntries(commit, gpui = false) {
  const parsed = parseReleaseNotes(commit.body, gpui);
  if (parsed.kind === "skip") return [];

  const entries = releaseNoteEntries(commit.body, gpui);
  if (parsed.kind === "missing") {
    const entry = fallbackReleaseEntry(commit.firstLine);
    if (!entry) return [];
    const text = attachLink(entry.text, commit);
    return [{
      section: entry.section,
      text,
      key: `${entry.section}\n${text}`,
    }];
  }

  return entries
    .map((line) => line.replace(/^\s*-\s+/, "").trim())
    .filter((text) => !/^N\/A\b/i.test(text) && !text.includes("<public_issue_number_if_exists>"))
    .map(normalizeExplicitEntry)
    .filter((entry) => entry !== null)
    .map((entry) => {
      const text = attachLink(entry.text, commit);
      return {
        section: entry.section,
        text,
        key: `${entry.section}\n${text}`,
      };
    });
}

function formatCommitEntry(commit, gpui = false) {
  return formatCommitEntries(commit, gpui)[0] || null;
}

function renderReleaseNotes(entries, compareUrl) {
  const seen = new Set();
  const grouped = new Map([
    ["New", []],
    ["Improvements", []],
    ["Fixes", []],
  ]);

  for (const entry of entries) {
    if (!entry || seen.has(entry.key)) continue;
    seen.add(entry.key);
    grouped.get(entry.section)?.push(entry.text);
  }

  const sections = [];
  for (const section of ["New", "Improvements", "Fixes"]) {
    const entriesForSection = grouped.get(section);
    if (!entriesForSection || entriesForSection.length === 0) continue;
    sections.push(`## ${section}\n\n${entriesForSection.map((entry) => `- ${entry}`).join("\n")}`);
  }

  if (sections.length === 0) {
    return `No public-facing changes in this release. [View the commits](${compareUrl}).\n`;
  }
  return `${sections.join("\n\n")}\n`;
}

function main() {
  const { error, version, channel, parts, gpui } = parseArguments();
  if (error) {
    console.error(error);
    console.error("");
    console.error(USAGE);
    process.exit(1);
  }
  // We currently draft notes only for patch releases.
  if (parts[2] === 0) process.exit(0);

  const priorVersion = [parts[0], parts[1], Number(parts[2]) - 1].join(".");
  const suffix = channel === "preview" ? "-pre" : "";
  const [tag, priorTag] = [`v${version}${suffix}`, `v${priorVersion}${suffix}`];

  try {
    execFileSync("rm", ["-rf", "target/shallow_clone"]);
    execFileSync("git", [
      "clone",
      "https://github.com/zed-industries/zed",
      "target/shallow_clone",
      "--filter=tree:0",
      "--no-checkout",
      "--branch",
      tag,
      "--depth",
      100,
    ]);
    execFileSync("git", ["-C", "target/shallow_clone", "rev-parse", "--verify", tag]);
    try {
      execFileSync("git", ["-C", "target/shallow_clone", "rev-parse", "--verify", priorTag]);
    } catch {
      console.error(`Prior tag ${priorTag} not found`);
      process.exit(0);
    }
  } catch (error) {
    console.error(error.stderr?.toString() || error.toString());
    process.exit(1);
  }

  const compareUrl = `https://github.com/zed-industries/zed/compare/${priorTag}...${tag}#commits_bucket`;
  const entries = getCommits(priorTag, tag).flatMap((commit) => formatCommitEntries(commit, gpui));
  console.log(renderReleaseNotes(entries, compareUrl));
}

function getCommits(oldTag, newTag) {
  const log = execFileSync(
    "git",
    [
      "-C",
      "target/shallow_clone",
      "log",
      `${oldTag}..${newTag}`,
      "--format=DIVIDER%n%H|||%s%n%b",
    ],
    { encoding: "utf8" },
  )
    .replace(/\r\n/g, "\n")
    .split("DIVIDER\n")
    .filter((commit) => commit.length > 0)
    .map((commit) => {
      const [header, ...bodyLines] = commit.split("\n");
      const [hash, ...subjectParts] = header.split("|||");
      const firstLine = subjectParts.join("|||").trim();
      const cherryPick = firstLine.match(/\(cherry-pick #([0-9]+)\)/)?.[1] || "";
      const pr = firstLine.match(/\(#(\d+)\)$/)?.[1] || "";
      return {
        hash,
        cherryPick,
        pr,
        firstLine,
        body: bodyLines.join("\n"),
      };
    });

  return log;
}

if (require.main === module) {
  main();
}

module.exports = {
  classifyReleaseEntry,
  fallbackReleaseEntry,
  filterReleaseNotes,
  formatCommitEntries,
  formatCommitEntry,
  parseReleaseNotes,
  renderReleaseNotes,
};
